{
  "name": "fullstack",
  "version": "1.0.0",
  "description": "test app nodejs and Angular",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "test": "npm run build && node scripts/test.cjs dist",
    "start": "node --enable-source-maps dist/main/index.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node --enable-source-maps dist/main/index.js\""
  },
  "keywords": [
    "angular",
    "express"
  ],
  "author": "Inc1981",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "express": "5.2.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": " 8.24.4",
    "morgan": "^1.10.0",
    "passport": "^0.4.1",
    "passport-jwt": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/body-parser": "1.19.6",
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "8.5.9",
    "@types/morgan": "1.9.10",
    "@types/node": "24.13.6",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "3.0.13",
    "nodemon": "^2.0.7",
    "typescript": "^7.0.2"
  },
  "type": "commonjs"
}
